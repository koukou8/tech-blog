---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TagBar from '../components/TagBar.astro';
import FilterPills from '../components/FilterPills.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// The lead article is the one flagged as featured, otherwise the newest one.
const leadPost = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const restPosts = allPosts.filter((p) => p.id !== leadPost?.id);

const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
const categories = [...new Set(allPosts.map((p) => p.data.category).filter(Boolean))] as string[];
---

<BaseLayout title="DEV LOG — 開発の、やわらかい倉庫。">
  <HeroSection articleCount={allPosts.length} tagCount={allTags.length} />

  <div class="mx-auto max-w-[1200px] px-8 pb-16 max-sm:px-5 max-sm:pb-10">
    <div class="mb-6 flex items-center justify-between gap-6">
      <h2 class="font-heading text-[1.15rem] font-extrabold tracking-[0.01em] text-ink">さいきん書いたもの</h2>
      <FilterPills categories={categories} />
    </div>

    <div class="grid grid-cols-2 gap-6 max-sm:grid-cols-1 max-sm:gap-4">
      {leadPost && (
        <div class="col-span-full" data-post-card data-cat={leadPost.data.category}>
          <FeaturedCard
            title={leadPost.data.title}
            description={leadPost.data.description}
            date={leadPost.data.date}
            tags={leadPost.data.tags}
            slug={leadPost.id}
            category={leadPost.data.category}
            image={leadPost.data.image}
            draft={leadPost.data.draft}
          />
        </div>
      )}

      {restPosts.map((post) => (
        <div data-post-card data-cat={post.data.category}>
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            slug={post.id}
            category={post.data.category}
            image={post.data.image}
            draft={post.data.draft}
          />
        </div>
      ))}
    </div>

    <TagBar tags={allTags} />
  </div>
</BaseLayout>
