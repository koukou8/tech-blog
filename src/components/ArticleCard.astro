---
import { toColumnText, dotDate } from '../lib/news';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  category?: string;
  body: string;
  page: number;
  draft?: boolean;
}

const { title, date, tags, slug, category, body, page, draft } = Astro.props;

const column = toColumnText(body, 190);
---

<article class="flex h-full flex-col">
  <div class="mb-4 flex items-center gap-3.5">
    <span class="badge bg-orange text-ink">{page}面</span>
    <span class="font-mono text-[0.76rem] tracking-[0.14em] text-ink-soft max-sm:text-[0.62rem]">
      {(category ?? 'ARTICLE').toUpperCase()}　／　{dotDate(date)}
    </span>
    {draft && <span class="badge bg-cyan text-ink">校了前</span>}
  </div>

  <h3 class="font-mincho text-[clamp(1.15rem,2vw,1.6rem)] leading-[1.5]" style="font-weight: 800;">
    <a href={`/articles/${slug}`} class="text-ink no-underline hover:underline">{title}</a>
  </h3>

  <div class="newscol columns-2 mt-4 flex-1 text-[0.85rem] leading-[2] max-sm:columns-1">
    <p>{column}</p>
  </div>

  <div class="mt-5 flex flex-wrap gap-4 font-mono text-[0.74rem] text-ink-mute max-sm:gap-2 max-sm:text-[0.62rem]">
    {tags.slice(0, 3).map((tag) => (
      <a href={`/tags/${tag}`} class="text-ink-mute no-underline hover:text-ink">#{tag}</a>
    ))}
  </div>
</article>
