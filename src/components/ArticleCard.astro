---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  category?: string;
  image?: string;
  draft?: boolean;
}

const { title, description, date, tags, slug, category, image, draft } = Astro.props;

const shortDate = date
  .toLocaleDateString('ja-JP', { month: '2-digit', day: '2-digit' })
  .replace(/\//g, '.');
---

<a
  href={`/articles/${slug}`}
  class="soft-hover flex h-full flex-col rounded-[26px] bg-mint p-7 no-underline max-sm:rounded-[22px] max-sm:p-5"
>
  <div class="mb-6 flex items-center gap-4">
    <span class="flex h-[46px] w-[46px] shrink-0 items-center justify-center overflow-hidden rounded-[15px] bg-accent">
      {image
        ? <img src={image} alt="" class="h-full w-full object-cover" />
        : <span class="font-code text-[0.9rem] font-bold text-white">&gt;_</span>}
    </span>
    <span class="text-[0.8rem] font-bold tracking-[0.18em] text-fg-secondary">
      {(category ?? 'ARTICLE').toUpperCase()}
    </span>
    <span class="ml-auto text-[0.82rem] font-medium text-fg-muted">{shortDate}</span>
  </div>

  <h3 class="mb-3 font-heading text-[1.2rem] font-black leading-[1.65] tracking-[0.01em] text-ink max-sm:text-[1.05rem]">
    {title}
    {draft && <span class="ml-2 align-middle rounded-full bg-orange-light px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.1em] text-[#8a6000]">DRAFT</span>}
  </h3>
  <p class="mb-6 flex-1 text-[0.9rem] leading-[2] text-fg-secondary max-sm:text-[0.85rem]">{description}</p>

  <div class="flex flex-wrap gap-2.5">
    {tags.slice(0, 3).map((tag) => (
      <span class="rounded-full bg-white px-4 py-2 text-[0.78rem] font-medium text-fg-secondary">{tag}</span>
    ))}
  </div>
</a>
