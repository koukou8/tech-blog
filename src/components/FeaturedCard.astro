---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  category?: string;
  image?: string;
  draft?: boolean;
}

const { title, description, date, tags, slug, category, image, draft } = Astro.props;

const glyphMap: Record<string, string> = {
  Books: '読',
  Tools: '具',
  Automation: '動',
  Design: '図',
  Frontend: '面',
  Infra: '基',
};
const glyph = glyphMap[category ?? ''] ?? '書';

const formattedDate = date
  .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .replace(/\//g, '.');
---

<a
  href={`/articles/${slug}`}
  class="soft-hover flex h-full gap-9 rounded-[28px] bg-mint-deep p-7 no-underline max-lg:flex-col max-lg:gap-6 max-sm:rounded-[22px] max-sm:p-5"
>
  <div class="relative flex h-[310px] w-[310px] shrink-0 flex-col justify-between overflow-hidden rounded-[24px] bg-orange p-6 max-lg:h-[190px] max-lg:w-full max-sm:h-[150px] max-sm:p-5">
    {image && <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" />}
    <span class="relative z-1 text-[0.82rem] font-bold tracking-[0.18em] text-ink/80">
      {(category ?? 'ARTICLE').toUpperCase()}
    </span>
    {!image && (
      <span class="relative z-1 font-heading text-[5.6rem] font-black leading-none text-ink max-lg:text-[3.4rem]">{glyph}</span>
    )}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center py-2">
    <div class="mb-4 flex flex-wrap items-center gap-4">
      <span class="rounded-full bg-white px-4 py-1.5 text-[0.72rem] font-bold tracking-[0.14em] text-ink">FEATURED</span>
      <span class="text-[0.85rem] font-medium text-fg-secondary">{formattedDate}</span>
      {draft && (
        <span class="rounded-full bg-orange-light px-4 py-1.5 text-[0.72rem] font-bold tracking-[0.14em] text-[#8a6000]">DRAFT</span>
      )}
    </div>
    <h3 class="mb-4 font-heading text-[1.85rem] font-black leading-[1.5] tracking-[0.01em] text-ink max-sm:text-[1.3rem]">{title}</h3>
    <p class="mb-6 text-[0.95rem] leading-[2] text-fg-secondary max-sm:text-[0.87rem]">{description}</p>
    <div class="flex flex-wrap gap-2.5">
      {tags.slice(0, 3).map((tag) => (
        <span class="rounded-full bg-white px-4 py-2 text-[0.8rem] font-medium text-fg-secondary">{tag}</span>
      ))}
    </div>
  </div>
</a>
