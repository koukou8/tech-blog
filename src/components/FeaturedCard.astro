---
import { toColumnText, dotDate } from '../lib/news';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  category?: string;
  body: string;
  draft?: boolean;
}

const { title, description, date, tags, slug, category, body, draft } = Astro.props;

const column = toColumnText(body, 300);
const dropcap = column.charAt(0);
const rest = column.slice(1);
---

<article class="animate-fade-up">
  <div class="mb-5 flex items-center gap-4">
    <span class="badge bg-cyan text-ink">一面</span>
    <span class="font-mono text-[0.78rem] tracking-[0.14em] text-ink-soft max-sm:text-[0.64rem]">
      {(category ?? 'ARTICLE').toUpperCase()}　／　{dotDate(date)}
    </span>
    {draft && <span class="badge bg-orange text-ink">校了前</span>}
  </div>

  <h2 class="font-mincho text-[clamp(1.9rem,4.4vw,3.3rem)] leading-[1.35] tracking-[0.01em]" style="font-weight: 800;">
    <a href={`/articles/${slug}`} class="text-ink no-underline hover:underline">{title}</a>
  </h2>

  <p class="mt-6 border-l-4 border-orange pl-5 font-mincho text-[1.08rem] leading-[1.9] max-sm:text-[0.95rem]">
    {description}
  </p>

  <div class="newscol columns-3 mt-7 text-[0.9rem] leading-[2] max-lg:columns-2 max-sm:columns-1">
    <p><span class="dropcap">{dropcap}</span>{rest}</p>
  </div>

  <div class="rule-thin mt-7 pt-3.5">
    <div class="flex items-center justify-between gap-4">
      <div class="flex flex-wrap gap-4 font-mono text-[0.76rem] text-ink-soft max-sm:gap-2 max-sm:text-[0.62rem]">
        {tags.slice(0, 3).map((tag) => (
          <a href={`/tags/${tag}`} class="text-ink-soft no-underline hover:text-ink">#{tag}</a>
        ))}
      </div>
      <a href={`/articles/${slug}`} class="shrink-0 font-gothic text-[0.82rem] font-bold text-ink no-underline hover:underline max-sm:text-[0.72rem]">
        全文へ &#9654;
      </a>
    </div>
  </div>
</article>
