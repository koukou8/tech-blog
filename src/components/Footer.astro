---
import { siteUrl } from '../lib/site-url';
---

<footer class="relative z-1 border-t-2 border-fg px-8 py-10 max-sm:px-5">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between max-sm:flex-col max-sm:gap-4">
    <span class="font-heading text-[0.82rem] font-bold">DEV LOG &copy; {new Date().getFullYear()}</span>
    <div class="flex gap-4">
      <a href="https://github.com" class="text-[0.75rem] font-semibold text-fg-secondary no-underline transition-colors hover:text-accent">GitHub</a>
      <a href="#" class="text-[0.75rem] font-semibold text-fg-secondary no-underline transition-colors hover:text-accent">X (Twitter)</a>
      <a href={siteUrl('/rss.xml')} class="text-[0.75rem] font-semibold text-fg-secondary no-underline transition-colors hover:text-accent">RSS</a>
    </div>
  </div>
</footer>
