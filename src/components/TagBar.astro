---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

<div class="mt-6 rounded-[26px] bg-mint px-8 py-8 max-sm:rounded-[22px] max-sm:px-5 max-sm:py-6">
  <div class="mb-6 flex items-center gap-3">
    <span class="h-2.5 w-2.5 rounded-full bg-orange"></span>
    <span class="font-heading text-[1rem] font-extrabold text-ink">タグでさがす</span>
    <span class="text-[0.85rem] font-medium text-fg-muted">{tags.length}</span>
  </div>
  <div class="flex flex-wrap gap-3">
    {tags.map((tag) => (
      <a
        href={`/tags/${tag}`}
        class="rounded-full bg-white px-5 py-2.5 text-[0.85rem] font-medium text-fg-secondary no-underline transition-colors hover:bg-accent hover:text-white"
      >
        {tag}
      </a>
    ))}
  </div>
</div>
