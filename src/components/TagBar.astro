---
interface Props {
  tags: string[];
  active?: string;
}
const { tags, active } = Astro.props;
---

<section class="pt-6">
  <h2 class="mb-5 font-mincho text-[1.05rem] tracking-[0.06em]" style="font-weight: 800;">総索引</h2>
  <div class="flex flex-wrap gap-x-9 gap-y-3.5 max-sm:gap-x-5">
    {tags.map((tag) => (
      <a
        href={`/tags/${tag}`}
        class:list={[
          'font-mincho text-[1.05rem] leading-none text-ink no-underline hover:bg-cyan-pale max-sm:text-[0.92rem]',
          tag === active ? 'bg-cyan px-2 py-1' : '',
        ]}
      >{tag}</a>
    ))}
  </div>
</section>
