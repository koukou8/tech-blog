---
const pathname = Astro.url.pathname;
const isArticles = pathname === '/' || pathname.startsWith('/articles');
const isTags = pathname.startsWith('/tags');
---

<header class="sticky top-0 z-100 bg-white/85 backdrop-blur-xl">
  <div class="mx-auto flex h-[76px] max-w-[1200px] items-center justify-between px-8 max-sm:h-[64px] max-sm:px-5">
    <a href="/" class="flex items-center gap-3 no-underline">
      <span class="flex h-[38px] w-[38px] items-center justify-center rounded-[13px] bg-accent text-[1rem] font-extrabold text-white max-sm:h-[32px] max-sm:w-[32px]">D</span>
      <span class="font-heading text-[1.15rem] font-extrabold tracking-[0.02em] text-fg max-sm:text-[1rem]">DEV LOG</span>
    </a>
    <nav class="flex items-center gap-2">
      <a
        href="/"
        class:list={[
          'rounded-full px-5 py-2 text-[0.85rem] font-bold no-underline transition-colors max-sm:px-3.5 max-sm:text-[0.78rem]',
          isArticles ? 'bg-ink text-white' : 'text-fg-secondary hover:bg-mint hover:text-fg',
        ]}
      >記事</a>
      <a
        href="/tags/all"
        class:list={[
          'rounded-full px-5 py-2 text-[0.85rem] font-bold no-underline transition-colors max-sm:px-3.5 max-sm:text-[0.78rem]',
          isTags ? 'bg-ink text-white' : 'text-fg-secondary hover:bg-mint hover:text-fg',
        ]}
      >タグ</a>
      <a href="/rss.xml" class="rounded-full px-5 py-2 text-[0.85rem] font-bold text-fg-secondary no-underline transition-colors hover:bg-mint hover:text-fg max-sm:px-3.5 max-sm:text-[0.78rem]">RSS</a>
    </nav>
  </div>
</header>
