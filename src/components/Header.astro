---
import { getCollection } from 'astro:content';

interface Props {
  pageLabel?: string;
  section?: string;
  prevHref?: string;
  nextHref?: string;
}
const { pageLabel = '総索引', section, prevHref, nextHref } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sections = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];

const latest = posts[0]?.data.date ?? new Date();
const weekday = ['日', '月', '火', '水', '木', '金', '土'][latest.getDay()];
const issueDate = `${latest.getFullYear()}年${latest.getMonth() + 1}月${latest.getDate()}日（${weekday}）`;
---

<header>
  <div class="flex items-baseline justify-between gap-6 py-4 max-sm:flex-col max-sm:gap-1">
    <a href="/" class="font-mincho text-[1.55rem] tracking-[0.16em] text-ink no-underline max-sm:text-[1.2rem]" style="font-weight: 800;">開発日報</a>
    <span class="font-mono text-[0.72rem] tracking-[0.12em] text-ink-soft max-sm:text-[0.58rem]">
      第{posts.length}号　／　{issueDate}　／　{sections.join('・')}
    </span>
  </div>

  <div class="rule-hair"></div>

  <div class="flex items-center justify-between gap-6 py-2.5 font-mono text-[0.74rem] tracking-[0.1em] text-ink-soft max-sm:text-[0.6rem]">
    <span>{pageLabel}{section ? `　／　${section}` : ''}</span>
    <nav class="flex gap-4 max-sm:gap-2">
      <a href="/tags/all" class="text-ink-soft no-underline hover:text-ink">総索引へ</a>
      <span class="text-rule">／</span>
      {prevHref
        ? <a href={prevHref} class="text-ink-soft no-underline hover:text-ink">前の記事</a>
        : <span class="text-rule">前の記事</span>}
      <span class="text-rule">／</span>
      {nextHref
        ? <a href={nextHref} class="text-ink-soft no-underline hover:text-ink">次の記事</a>
        : <span class="text-rule">次の記事</span>}
    </nav>
  </div>

  <div class="rule-thick"></div>
</header>
