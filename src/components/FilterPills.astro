---
interface Props {
  categories: string[];
  active?: string;
}
const { categories, active = 'All' } = Astro.props;
---

<div class="flex gap-1.5 max-sm:hidden">
  {categories.map((cat) => (
    <button
      class:list={[
        "font-body text-[0.72rem] font-semibold px-3.5 py-1.5 border-2 rounded-full cursor-pointer transition-all",
        cat === active
          ? "bg-accent text-white border-accent"
          : "border-border text-fg-secondary bg-transparent hover:border-accent hover:text-accent"
      ]}
    >
      {cat}
    </button>
  ))}
</div>
