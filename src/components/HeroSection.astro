---
interface Props {
  articleCount: number;
  tagCount: number;
}
const { articleCount, tagCount } = Astro.props;
---

<section class="mx-auto max-w-[1200px] px-8 pt-4 pb-14 max-sm:px-5 max-sm:pb-10">
  <div class="animate-slide-up relative overflow-hidden rounded-[36px] bg-accent px-14 pt-14 pb-16 max-lg:px-9 max-lg:pb-12 max-sm:rounded-[28px] max-sm:px-6 max-sm:pt-9 max-sm:pb-9">
    <!-- orange blob tucked behind the stat cards -->
    <div class="absolute top-0 right-[38px] h-[158px] w-[330px] rounded-b-[104px] bg-orange max-lg:hidden"></div>

    <div class="relative grid grid-cols-[1fr_340px] items-start gap-10 max-lg:grid-cols-1 max-lg:gap-8">
      <div>
        <p class="mb-6 text-[0.82rem] font-medium tracking-[0.3em] text-ink/70 max-sm:text-[0.7rem] max-sm:tracking-[0.22em]">
          warehouse of development
        </p>
        <h1 class="font-heading text-[clamp(2.4rem,5.6vw,4.4rem)] font-black leading-[1.3] tracking-[0.01em] text-ink">
          <span class="block">開発の、</span>
          <span class="block">やわらかい倉庫。</span>
        </h1>
        <p class="mt-8 max-w-[330px] text-[0.95rem] font-medium leading-[2.1] text-ink/80 max-sm:mt-6 max-sm:text-[0.88rem]">
          開発について幅広く書きます。うまくいったことも、まだ途中のことも。
        </p>
      </div>

      <div class="flex flex-col gap-4 max-lg:flex-row max-sm:flex-col">
        <div class="rounded-[24px] bg-white px-8 py-7 max-lg:flex-1 max-sm:px-6 max-sm:py-5">
          <div class="font-heading text-[2.1rem] font-black leading-none text-ink max-sm:text-[1.7rem]">{articleCount}</div>
          <div class="mt-2 text-[0.85rem] font-medium text-fg-secondary">記事</div>
        </div>
        <div class="rounded-[24px] bg-white px-8 py-7 max-lg:flex-1 max-sm:px-6 max-sm:py-5">
          <div class="font-heading text-[2.1rem] font-black leading-none text-ink max-sm:text-[1.7rem]">{tagCount}</div>
          <div class="mt-2 text-[0.85rem] font-medium text-fg-secondary">タグ</div>
        </div>
      </div>
    </div>
  </div>
</section>
