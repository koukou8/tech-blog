---
interface Props {
  articleCount: number;
  tagCount: number;
}
const { articleCount, tagCount } = Astro.props;
---

<section class="relative z-1 mx-auto max-w-[1200px] px-8 pt-16 pb-12 max-sm:px-5 max-sm:pt-10 max-sm:pb-8">
  <div class="grid grid-cols-2 items-center gap-8 max-[960px]:grid-cols-1">
    <div class="animate-slide-up">
      <span class="mb-3 inline-block -rotate-[2deg] rounded-md bg-accent px-2.5 py-1 font-heading text-[0.66rem] font-extrabold uppercase tracking-[0.15em] text-white shadow-[0_3px_10px_rgba(214,35,0,0.3)]">
        Always flame-grilled
      </span>
      <h1 class="mb-4 font-display text-[clamp(2.8rem,7vw,5.2rem)] italic leading-[0.92] tracking-tight uppercase">
        <span class="block text-fg">warehouse of</span>
        <span class="inline-block -skew-x-6 rounded-lg bg-accent px-[0.25em] py-[0.02em] text-bg shadow-[5px_5px_0_var(--color-fg)]">
          development
        </span>
      </h1>
      <p class="mt-5 max-w-[380px] font-body text-[0.95rem] font-medium leading-[1.85] text-fg-secondary">
        開発について幅広く書きます。
      </p>
    </div>
    <div class="flex flex-wrap justify-end gap-3 max-[960px]:justify-start" style="animation: slideUp 0.5s ease-out 0.1s both;">
      <div class="min-w-[120px] rounded-2xl border-2 border-fg bg-bg-card p-[1.15rem_1.4rem] shadow-[3px_3px_0_var(--color-fg)] transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-fg)]">
        <div class="font-mono text-[1.6rem] font-bold leading-none text-accent">{articleCount}</div>
        <div class="text-[0.68rem] font-semibold tracking-wide text-fg-secondary">Articles</div>
      </div>
      <div class="min-w-[120px] rounded-2xl border-2 border-fg bg-bg-card p-[1.15rem_1.4rem] shadow-[3px_3px_0_var(--color-fg)] transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-fg)]">
        <div class="font-mono text-[1.6rem] font-bold leading-none text-sky">{tagCount}</div>
        <div class="text-[0.68rem] font-semibold tracking-wide text-fg-secondary">Tags</div>
      </div>
    </div>
  </div>
</section>
